#include "char_lcd.h"
#include "timebase.h"

/*VSS		GND
 *VDD		+5V
 *A			+5V
 *V0		Potentiometer
 *K			GND
 *
 *RS		PB5
 *RW        GND
 *E			PB7
 *
 *D4 		PC4
 *D5		PC5
 *D6		PC6
 *D7		PC7
 * */

#define RS		(1U<<5)
#define EN		(1U<<7)


#define GPIOBEN		(1U<<1)
#define GPIOCEN		(1U<<2)



void lcd_init(void)
{
	lcd_cmd(0x06);//increments automatically
	delay(4);
	lcd_cmd(0x01); //clear display
	delay(1);
	lcd_cmd(0x0F); //Turn on display

	lcd_cmd(0x20); //Set cursor moving
	delay(1);

	lcd_cmd(0x28); /*Set data length and number of lines*/
	delay(1);
}

void lcd_set_cursor_pos(int a, int b)
{
	switch(b)
	{
		case 0:lcd_cmd(0x80);break;
		case 1:lcd_cmd(0xC0);break;
		case 2:lcd_cmd(0x94);break;
		case 3:lcd_cmd(0xd4);break;
	}

	for(int i = 0; i < a;i++)
	{
		lcd_cmd(0x14);
	}
}

void lcd_gpio_init(void)
{
	/*Enable Clock Access to GPIOB and GPIOC*/
	RCC->AHB1ENR |= GPIOBEN |GPIOCEN;

	/*Set PB7 and PB5 as output pins*/
	GPIOB->MODER |=(1U<<14);
	GPIOB->MODER |=(1U<<10);

	/*Set PC4-PC7 as output pins*/
	GPIOC->MODER |=(1U<<8);
	GPIOC->MODER |=(1U<<10);
	GPIOC->MODER |=(1U<<12);
	GPIOC->MODER |=(1U<<14);


}


static void lcd_nibble_write(char data, char control)
{
	/*Clear data lines*/
	GPIOC->BSRR |= (1U<<23);
	GPIOC->BSRR |= (1U<<22);
	GPIOC->BSRR |= (1U<<21);
	GPIOC->BSRR |= (1U<<20);

	GPIOC->BSRR =  data & 0xF0;

	if( control & RS)
	{
		GPIOB->BSRR =  RS;
	}
	else
	{
		GPIOB->BSRR =  RS << 16;
	}

	/*Pull EN high*/
	GPIOB->BSRR = EN;
	delay(1);

	/*Pull EN low */
	GPIOB->BSRR = (EN<<16);
	delay(1);

}

void lcd_cmd(char ch)
{
	/*Write upper 4-bits*/
	lcd_nibble_write(ch & 0xF0, 0);

	/*Write lower 4-bits*/
	lcd_nibble_write(ch << 4, 0);

	if(ch << 4)
	{
		delay(2);
	}
	else
	{
		delay(1);

	}

}


void lcd_write(char *p)
{
	while(*p != '\0' )
	{
		ldc_data(*p);
		p++;
		delay(1);
	}
}

void lcd_data(char ch)
{
	/*Write upper 4-bits*/
	lcd_nibble_write(ch & 0xF0, RS);

	/*Write lower 4-bits*/
	lcd_nibble_write(ch << 4, RS);

	delay(1);

}

