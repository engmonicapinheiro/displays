char ssd1306_put_ch(char ch, SSD1306_COLOR_t color)
{
    /* Declare variables for looping through the font */
	uint32_t i, b, j;

	   /* Check if there is enough space On the oled to display the character */
	if (
		SSD1306_WIDTH <= (SSD1306.CurrentX + FONT_WIDTH) ||
		SSD1306_HEIGHT <= (SSD1306.CurrentY + FONT_HEIGHT)
	) {
		/* If there is not enough space, return 0 */
		return 0;
	}

    /* Go through the font data */
	for (i = 0; i < FONT_HEIGHT; i++) {
        /* Get the byte of data for the current row of the character */
		b = font_data[(ch - 32) * FONT_HEIGHT + i];
		for (j = 0; j < FONT_WIDTH; j++) {
            /* Check if the current bit of the byte is set */
			if ((b << j) & 0x8000) {
                /* If the bit is set, draw a pixel of the specified color at the current position */
				ssd1306_draw_pixel(SSD1306.CurrentX + j, (SSD1306.CurrentY + i), (SSD1306_COLOR_t) color);
			} else {
                /* If the bit is not set, draw a pixel of the opposite color at the current position */
				ssd1306_draw_pixel(SSD1306.CurrentX + j, (SSD1306.CurrentY + i), (SSD1306_COLOR_t)!color);
			}
		}
	}

    /* Increase the current x position for the next character */
	SSD1306.CurrentX += FONT_WIDTH;

    /* Return the character that was written */
	return ch;
}

char ssd1306_put_str(char* str, SSD1306_COLOR_t color)
{
    /* Write characters in the string one by one to the OLED display */
	while (*str) {
		/* Write current character */
		if (ssd1306_put_ch(*str,color) != *str) {
			/* If the function returns an error, return the character that caused the error */
			return *str;
		}

		/* Move to next character in the string */
		str++;
	}
	/* If all characters are written successfully, return 0 i.e. null */
	return *str;
}

/*
 * This function  takes in 5 arguments: the
starting x and y coordinates (x0 and y0), the ending x
and y coordinates (x1 and y1), and the color of the
line (c). The first thing the function does is check
for overflow on the x and y coordinates. If any of the
coordinates are greater than the width or height of
the OLED display, they are set to the maximum value
(width - 1 or height - 1) to prevent drawing outside
the display. The function then calculates the change
in x and y (dx and dy), the x and y direction (sx and
sy), and the error value (err). If dx is 0, the line
is a vertical line. In this case, the function
iterates from the starting y coordinate to the ending
y coordinate, drawing a pixel at the x0 coordinate
and the current y value. The function then returns.
If dy is 0, the line is a horizontal line. In this
case, the function iterates from the starting x
coordinate to the ending x coordinate, drawing a pixel
at the current x value and the y0 coordinate. The
function then returns. If dx and dy are not 0, the
line is a diagonal line. The function enters a while
loop that continues until the starting and ending
coordinates are the same (x0 == x1 and y0 == y1).
Inside the loop, the function draws a pixel at the
current x and y values, and updates the x and y
coordinates and the error value. Once the loop is
finished, the function*/

void ssd1306_draw_line(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1, SSD1306_COLOR_t c)
{
    int16_t dx, dy, sx, sy, err, e2, i, tmp;

    /* Check for overflow */
     if (x0 >= SSD1306_WIDTH) {
         x0 = SSD1306_WIDTH - 1;
     }

     if (x1 >= SSD1306_WIDTH) {
         x1 = SSD1306_WIDTH - 1;
     }

     if (y0 >= SSD1306_HEIGHT) {
         y0 = SSD1306_HEIGHT - 1;
     }
     if (y1 >= SSD1306_HEIGHT) {
         y1 = SSD1306_HEIGHT - 1;
     }


     /* Calculate the change in x and y */
     dx = (x0 < x1) ? (x1 - x0) : (x0 - x1);
     dy = (y0 < y1) ? (y1 - y0) : (y0 - y1);

     /* Determine the direction of the line */
     sx = (x0 < x1) ? 1 : -1;
     sy = (y0 < y1) ? 1 : -1;

     /* Initialize the error term */
     err = ((dx > dy) ? dx : -dy) / 2;

     /* Check for a vertical line */
      if (dx == 0) {
          /* swap y0 and y1 if y1 is smaller than y0 */
          if (y1 < y0) {
              tmp = y1;
              y1 = y0;
              y0 = tmp;
          }
          /* Draw a vertical line by looping through the y-coordinates and drawing
           * a pixel at the specified x-coordinate */
            for (i = y0; i <= y1; i++) {
                ssd1306_draw_pixel(x0, i, c);
            }
            return;
      }

      /*Check for horizontal line*/
      if (dy == 0) {
          if (y1 < y0) {
              tmp = y1;
              y1 = y0;
              y0 = tmp;
          }

          if (x1 < x0) {
              tmp = x1;
              x1 = x0;
              x0 = tmp;
          }
          /* Draw a horizontal line by looping through the x-coordinates
           * and drawing a pixel at the specified y-coordinate */
      	/* Horizontal line */
      		for (i = x0; i <= x1; i++) {
      			ssd1306_draw_pixel(i, y0, c);
      		}

      		/* Return from function */
      		return;

      }
      while (1) {
          /* Draw the current pixel */
          ssd1306_draw_pixel(x0, y0, c);
          /* If the end point has been reached, break out of the loop */
          if (x0 == x1 && y0 == y1) {
              break;
          }
          /* Calculate the next error value and update the x and y coordinates accordingly */

          e2 = err;
          if (e2 > -dx) {
              err -= dy;
              x0 += sx;
          }
          if (e2 < dy) {
              err += dx;
              y0 += sy;
          }
      }
}


void ssd1306_clear(void)
{
	/*Clear screen*/
	ssd1306_fill(SSD1306_COLOR_BLACK);

	/*Update screen*/
	ssd1306_update_screen();
}


